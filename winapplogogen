<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Windows App Logo Generator</title>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/ico-endec@1.0.2/dist/ico-endec.min.js"></script>
        <style>
            :root {
                --bg: #f5f5f5;
                --surface: #ffffff;
                --surface2: #fafafa;
                --text: #1f2937;
                --muted: #6b7280;
                --border: #e5e7eb;
                --border2: #d1d5db;
                --primary: #2563eb;
                --primary-hover: #1d4ed8;
            }

            * {
                box-sizing: border-box;
            }

            html,
            body {
                height: 100%;
            }

            body {
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                color: var(--text);
                background: var(--bg);
                padding: 24px;
            }

            .container {
                max-width: 1100px;
                margin: 0 auto;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 10px;
                overflow: hidden;
            }

            .header {
                padding: 20px 24px;
                border-bottom: 1px solid var(--border);
                background: var(--surface);
            }

            .header h1 {
                font-size: 18px;
                margin: 0 0 6px;
                font-weight: 600;
            }

            .header p {
                margin: 0;
                color: var(--muted);
                font-size: 13px;
            }

            .content {
                padding: 24px;
            }

            .section {
                margin-bottom: 18px;
            }

            .section-title {
                margin: 0 0 10px;
                font-size: 14px;
                font-weight: 600;
            }

            .specs {
                background: var(--surface2);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 14px 16px;
            }

            .specs ul {
                margin: 8px 0 0;
                padding-left: 18px;
                color: var(--muted);
                font-size: 13px;
                line-height: 1.6;
            }

            .upload-area {
                background: var(--surface2);
                border: 2px dashed var(--border2);
                border-radius: 10px;
                padding: 28px 18px;
                text-align: center;
                cursor: pointer;
                user-select: none;
            }

            .upload-area:hover {
                border-color: var(--primary);
            }

            .upload-area.dragover {
                border-color: var(--primary);
                background: #eff6ff;
            }

            .upload-title {
                margin: 0 0 6px;
                font-weight: 600;
                font-size: 14px;
            }

            .upload-sub {
                margin: 0;
                color: var(--muted);
                font-size: 13px;
            }

            .grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .panel {
                background: var(--surface2);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 14px;
            }

            .field {
                margin-top: 12px;
            }

            .label {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                gap: 8px;
                font-size: 13px;
                font-weight: 600;
            }

            .hint {
                font-size: 12px;
                color: var(--muted);
                margin-top: 6px;
            }

            select,
            input[type="text"] {
                width: 100%;
                height: 34px;
                border: 1px solid var(--border2);
                border-radius: 8px;
                padding: 0 10px;
                background: var(--surface);
                color: var(--text);
                font-size: 13px;
            }

            input[type="range"] {
                width: 100%;
            }

            input[type="color"] {
                width: 56px;
                height: 34px;
                border: 1px solid var(--border2);
                border-radius: 8px;
                background: var(--surface);
                padding: 0;
            }

            .row {
                display: flex;
                gap: 10px;
                align-items: center;
            }

            .bg-image-drop {
                border: 2px dashed var(--border2);
                border-radius: 10px;
                padding: 14px;
                background: var(--surface);
                text-align: center;
                cursor: pointer;
                font-size: 13px;
                color: var(--muted);
            }

            .thumb {
                margin-top: 10px;
                display: none;
                gap: 10px;
                align-items: center;
            }

            .thumb img {
                max-height: 56px;
                border: 1px solid var(--border);
                border-radius: 6px;
            }

            .preview {
                display: none;
                margin-top: 18px;
            }

            .preview.active {
                display: block;
            }

            .original {
                display: grid;
                grid-template-columns: 180px 1fr;
                gap: 14px;
                align-items: center;
                background: var(--surface2);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 14px;
            }

            .original img {
                width: 180px;
                height: 180px;
                object-fit: contain;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 8px;
            }

            .assets-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 12px;
                margin-top: 12px;
            }

            .asset-card {
                background: var(--surface2);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 14px;
                display: grid;
                gap: 10px;
                justify-items: center;
            }

            .asset-card h4 {
                margin: 0;
                font-size: 13px;
                font-weight: 600;
                text-align: center;
            }

            .asset-meta {
                color: var(--muted);
                font-size: 12px;
            }

            canvas {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 6px;
                max-width: 100%;
                height: auto;
            }

            .actions {
                display: flex;
                gap: 10px;
                margin-top: 14px;
                justify-content: flex-start;
            }

            .btn {
                appearance: none;
                border: 1px solid transparent;
                border-radius: 8px;
                padding: 9px 14px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                background: var(--primary);
                color: white;
            }

            .btn:hover {
                background: var(--primary-hover);
            }

            .btn:active {
                transform: translateY(1px);
            }

            .btn-secondary {
                background: white;
                color: var(--text);
                border-color: var(--border2);
            }

            .btn-secondary:hover {
                background: #f9fafb;
            }

            .footer {
                border-top: 1px solid var(--border);
                padding: 14px 24px;
                color: var(--muted);
                font-size: 12px;
            }

            @media (max-width: 800px) {
                body {
                    padding: 12px;
                }

                .content {
                    padding: 16px;
                }

                .grid {
                    grid-template-columns: 1fr;
                }

                .original {
                    grid-template-columns: 1fr;
                }

                .original img {
                    width: 100%;
                    height: 200px;
                }
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <h1>Windows App Logo Generator</h1>
                <p>1つの画像からWindowsアプリ用アセットを生成します</p>
            </div>

            <div class="content">
                <div class="section specs">
                    <div class="section-title">生成されるアセット</div>
                    <ul>
                        <li>Square150x150Logo.png (150×150)</li>
                        <li>Square44x44Logo.png (44×44)</li>
                        <li>Wide310x150Logo.png (310×150)</li>
                        <li>SplashScreen.png (620×300)</li>
                        <li>AppLogo.ico (16, 32, 48, 64, 128, 256)</li>
                    </ul>
                </div>

                <div class="section">
                    <div class="upload-area" id="uploadArea" role="button" tabindex="0">
                        <p class="upload-title">画像をドラッグ＆ドロップ</p>
                        <p class="upload-sub">またはクリックして選択</p>
                        <p class="upload-sub" style="margin-top: 8px">推奨: 512×512以上の正方形画像</p>
                    </div>
                    <input type="file" id="fileInput" accept="image/*" hidden />
                </div>

                <div class="section" id="settingsSection" style="display: none">
                    <div class="section-title">Wide / SplashScreen 設定</div>
                    <div class="grid">
                        <div class="panel">
                            <div class="section-title">背景</div>

                            <div class="field">
                                <div class="label"><span>背景タイプ</span></div>
                                <select id="bgType">
                                    <option value="color">単色</option>
                                    <option value="image">画像</option>
                                </select>
                            </div>

                            <div class="field" id="colorBgSection">
                                <div class="label"><span>背景色</span></div>
                                <div class="row" style="margin-top: 6px">
                                    <input type="color" id="bgColor" value="#2563eb" />
                                    <input type="text" id="bgColorText" value="#2563eb" inputmode="text" />
                                </div>
                                <div class="hint">例: #2563eb</div>
                            </div>

                            <div class="field" id="imageBgSection" style="display: none">
                                <div class="label"><span>背景画像</span></div>
                                <div id="bgImageArea" class="bg-image-drop" style="margin-top: 6px">クリックして選択</div>
                                <input type="file" id="bgImageInput" accept="image/*" hidden />

                                <div class="thumb" id="bgImagePreview">
                                    <img id="bgImageThumb" alt="Background preview" />
                                    <button class="btn btn-secondary" type="button" id="bgImageClearBtn">クリア</button>
                                </div>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="section-title">ロゴサイズ</div>

                            <div class="field">
                                <div class="label">
                                    <span>Wide310x150</span>
                                    <span id="wideScaleValue">70%</span>
                                </div>
                                <input type="range" id="wideScale" min="20" max="100" value="70" />
                                <div class="hint">ロゴが背景に占める割合</div>
                            </div>

                            <div class="field">
                                <div class="label">
                                    <span>SplashScreen</span>
                                    <span id="splashScaleValue">50%</span>
                                </div>
                                <input type="range" id="splashScale" min="20" max="100" value="50" />
                                <div class="hint">ロゴが背景に占める割合</div>
                            </div>

                            <div class="actions" style="margin-top: 12px">
                                <button class="btn" type="button" id="applySettingsBtn">プレビューを更新</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="preview" id="previewSection">
                    <div class="section-title">プレビュー</div>
                    <div class="original">
                        <img id="originalImage" alt="Original" />
                        <div>
                            <div class="section-title" style="margin-bottom: 6px">元画像</div>
                            <div class="hint">生成はブラウザ内で完結します。画像は外部送信しません。</div>
                            <div class="actions">
                                <button class="btn" type="button" id="downloadAllBtn">すべてをZIPでダウンロード</button>
                                <button class="btn btn-secondary" type="button" id="resetBtn">別の画像を選択</button>
                            </div>
                        </div>
                    </div>

                    <div class="assets-grid" id="assetsGrid"></div>
                </div>
            </div>

            <div class="footer">© 2025 Windows App Logo Generator</div>
        </div>

        <script>
            const assets = [
                { name: "Square150x150Logo.png", width: 150, height: 150, kind: "png" },
                { name: "Square44x44Logo.png", width: 44, height: 44, kind: "png" },
                { name: "Wide310x150Logo.png", width: 310, height: 150, kind: "custom" },
                { name: "SplashScreen.png", width: 620, height: 300, kind: "custom" },
                { name: "AppLogo.ico", width: 256, height: 256, kind: "ico", sizes: [16, 32, 48, 64, 128, 256] },
            ];

            let sourceImage = null;
            let backgroundImage = null;

            const uploadArea = document.getElementById("uploadArea");
            const fileInput = document.getElementById("fileInput");
            const settingsSection = document.getElementById("settingsSection");
            const previewSection = document.getElementById("previewSection");
            const originalImage = document.getElementById("originalImage");
            const assetsGrid = document.getElementById("assetsGrid");

            const bgType = document.getElementById("bgType");
            const bgColor = document.getElementById("bgColor");
            const bgColorText = document.getElementById("bgColorText");
            const bgImageInput = document.getElementById("bgImageInput");
            const bgImageArea = document.getElementById("bgImageArea");
            const bgImagePreview = document.getElementById("bgImagePreview");
            const bgImageThumb = document.getElementById("bgImageThumb");
            const bgImageClearBtn = document.getElementById("bgImageClearBtn");
            const wideScale = document.getElementById("wideScale");
            const splashScale = document.getElementById("splashScale");
            const wideScaleValue = document.getElementById("wideScaleValue");
            const splashScaleValue = document.getElementById("splashScaleValue");
            const applySettingsBtn = document.getElementById("applySettingsBtn");
            const downloadAllBtn = document.getElementById("downloadAllBtn");
            const resetBtn = document.getElementById("resetBtn");

            function setPreviewVisible(visible) {
                previewSection.classList.toggle("active", visible);
                previewSection.style.display = visible ? "block" : "none";
            }

            function setSettingsVisible(visible) {
                settingsSection.style.display = visible ? "block" : "none";
            }

            function isHexColor(value) {
                return /^#[0-9a-fA-F]{6}$/.test(value);
            }

            // Upload
            uploadArea.addEventListener("click", () => fileInput.click());
            uploadArea.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") fileInput.click();
            });

            fileInput.addEventListener("change", (e) => {
                const file = e.target.files?.[0];
                if (file) handleSourceFile(file);
            });

            uploadArea.addEventListener("dragover", (e) => {
                e.preventDefault();
                uploadArea.classList.add("dragover");
            });

            uploadArea.addEventListener("dragleave", () => uploadArea.classList.remove("dragover"));

            uploadArea.addEventListener("drop", (e) => {
                e.preventDefault();
                uploadArea.classList.remove("dragover");
                const file = e.dataTransfer.files?.[0];
                if (file) handleSourceFile(file);
            });

            async function fileToImage(file) {
                if (!file.type.startsWith("image/")) throw new Error("画像ファイルを選択してください");
                const dataUrl = await new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = () => reject(new Error("ファイル読み込みに失敗しました"));
                    reader.readAsDataURL(file);
                });

                const img = await new Promise((resolve, reject) => {
                    const image = new Image();
                    image.onload = () => resolve(image);
                    image.onerror = () => reject(new Error("画像の読み込みに失敗しました"));
                    image.src = dataUrl;
                });

                return { img, dataUrl };
            }

            async function handleSourceFile(file) {
                try {
                    const { img, dataUrl } = await fileToImage(file);
                    sourceImage = img;
                    originalImage.src = dataUrl;
                    setSettingsVisible(true);
                    setPreviewVisible(true);
                    generateAssets();
                } catch (err) {
                    alert(err?.message ?? "画像の処理に失敗しました");
                }
            }

            // Settings
            bgType.addEventListener("change", () => {
                const isColor = bgType.value === "color";
                document.getElementById("colorBgSection").style.display = isColor ? "block" : "none";
                document.getElementById("imageBgSection").style.display = isColor ? "none" : "block";
            });

            bgColor.addEventListener("input", (e) => {
                bgColorText.value = e.target.value;
            });

            bgColorText.addEventListener("input", (e) => {
                const value = e.target.value.trim();
                if (isHexColor(value)) bgColor.value = value;
            });

            wideScale.addEventListener("input", (e) => {
                wideScaleValue.textContent = `${e.target.value}%`;
            });

            splashScale.addEventListener("input", (e) => {
                splashScaleValue.textContent = `${e.target.value}%`;
            });

            applySettingsBtn.addEventListener("click", () => regenerateCustomAssets());

            bgImageArea.addEventListener("click", () => bgImageInput.click());
            bgImageInput.addEventListener("change", async (e) => {
                const file = e.target.files?.[0];
                if (!file) return;
                try {
                    const { img, dataUrl } = await fileToImage(file);
                    backgroundImage = img;
                    bgImageThumb.src = dataUrl;
                    bgImagePreview.style.display = "flex";
                } catch (err) {
                    alert(err?.message ?? "背景画像の処理に失敗しました");
                }
            });

            bgImageClearBtn.addEventListener("click", () => {
                backgroundImage = null;
                bgImageInput.value = "";
                bgImageThumb.src = "";
                bgImagePreview.style.display = "none";
            });

            downloadAllBtn.addEventListener("click", () => downloadAll());
            resetBtn.addEventListener("click", () => resetApp());

            // Drawing helpers
            function drawContain(ctx, img, targetW, targetH) {
                const scale = Math.min(targetW / img.width, targetH / img.height);
                const w = img.width * scale;
                const h = img.height * scale;
                const x = (targetW - w) / 2;
                const y = (targetH - h) / 2;
                ctx.drawImage(img, x, y, w, h);
            }

            function drawCover(ctx, img, targetW, targetH) {
                const scale = Math.max(targetW / img.width, targetH / img.height);
                const w = img.width * scale;
                const h = img.height * scale;
                const x = (targetW - w) / 2;
                const y = (targetH - h) / 2;
                ctx.drawImage(img, x, y, w, h);
            }

            function drawCustomAsset(ctx, asset) {
                // background
                if (bgType.value === "image" && backgroundImage) {
                    drawCover(ctx, backgroundImage, asset.width, asset.height);
                } else {
                    ctx.fillStyle = bgColor.value;
                    ctx.fillRect(0, 0, asset.width, asset.height);
                }

                const pct = asset.name === "Wide310x150Logo.png" ? Number(wideScale.value) / 100 : Number(splashScale.value) / 100;
                const box = Math.min(asset.width, asset.height) * pct;
                const scale = Math.min(box / sourceImage.width, box / sourceImage.height);
                const w = sourceImage.width * scale;
                const h = sourceImage.height * scale;
                const x = (asset.width - w) / 2;
                const y = (asset.height - h) / 2;
                ctx.drawImage(sourceImage, x, y, w, h);
            }

            function drawAsset(canvas, asset) {
                const ctx = canvas.getContext("2d");
                ctx.clearRect(0, 0, asset.width, asset.height);

                if (asset.kind === "custom") {
                    drawCustomAsset(ctx, asset);
                    return;
                }

                // default: white background
                ctx.fillStyle = "white";
                ctx.fillRect(0, 0, asset.width, asset.height);
                drawContain(ctx, sourceImage, asset.width, asset.height);
            }

            function generateAssets() {
                assetsGrid.innerHTML = "";

                for (const asset of assets) {
                    const card = document.createElement("div");
                    card.className = "asset-card";

                    const title = document.createElement("h4");
                    title.textContent = asset.name;
                    card.appendChild(title);

                    const canvas = document.createElement("canvas");
                    canvas.width = asset.width;
                    canvas.height = asset.height;
                    canvas.id = `canvas-${asset.name}`;
                    drawAsset(canvas, asset.kind === "ico" ? { ...asset, kind: "png" } : asset);
                    // preview for ICO is the 256px PNG look
                    card.appendChild(canvas);

                    const meta = document.createElement("div");
                    meta.className = "asset-meta";
                    meta.textContent = `${asset.width}×${asset.height}px`;
                    card.appendChild(meta);

                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "btn";
                    btn.textContent = "ダウンロード";
                    btn.addEventListener("click", async () => {
                        if (asset.kind === "ico") {
                            await downloadAsICO(asset);
                        } else {
                            await downloadCanvasAsPng(canvas, asset.name);
                        }
                    });
                    card.appendChild(btn);

                    assetsGrid.appendChild(card);
                }
            }

            function regenerateCustomAssets() {
                for (const asset of assets) {
                    if (asset.kind !== "custom") continue;
                    const canvas = document.getElementById(`canvas-${asset.name}`);
                    if (canvas) drawAsset(canvas, asset);
                }
            }

            async function downloadCanvasAsPng(canvas, filename) {
                const blob = await new Promise((resolve) => canvas.toBlob(resolve));
                if (!blob) throw new Error("画像の書き出しに失敗しました");
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }

            async function pngBytesFromSize(size) {
                const canvas = document.createElement("canvas");
                canvas.width = size;
                canvas.height = size;
                const ctx = canvas.getContext("2d");

                ctx.clearRect(0, 0, size, size);
                // ICOは透過を活かしたいので、背景は塗らない
                drawContain(ctx, sourceImage, size, size);

                const blob = await new Promise((resolve) => canvas.toBlob(resolve));
                if (!blob) throw new Error("PNG生成に失敗しました");
                const buf = await blob.arrayBuffer();
                return new Uint8Array(buf);
            }

            async function downloadAsICO(asset) {
                try {
                    if (!window.IcoEndec || typeof window.IcoEndec.encode !== "function") {
                        throw new Error("ICOエンコーダが読み込めませんでした");
                    }

                    const images = [];
                    for (const size of asset.sizes) {
                        images.push(await pngBytesFromSize(size));
                    }

                    const icoBytes = window.IcoEndec.encode(images);
                    const blob = new Blob([icoBytes], { type: "image/x-icon" });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement("a");
                    a.href = url;
                    a.download = asset.name;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                } catch (err) {
                    console.error(err);
                    alert("AppLogo.icoの生成に失敗しました。代わりに256×256のPNGをダウンロードします。");
                    // fallback
                    const canvas = document.getElementById(`canvas-${asset.name}`);
                    if (canvas) await downloadCanvasAsPng(canvas, "AppLogo.png");
                }
            }

            async function downloadAll() {
                try {
                    const zip = new JSZip();
                    const folder = zip.folder("Assets");

                    for (const asset of assets) {
                        if (asset.kind === "ico") {
                            if (window.IcoEndec && typeof window.IcoEndec.encode === "function") {
                                const images = [];
                                for (const size of asset.sizes) {
                                    images.push(await pngBytesFromSize(size));
                                }
                                const icoBytes = window.IcoEndec.encode(images);
                                folder.file(asset.name, icoBytes);
                            } else {
                                const canvas = document.getElementById(`canvas-${asset.name}`);
                                const blob = await new Promise((resolve) => canvas.toBlob(resolve));
                                folder.file("AppLogo.png", blob);
                            }
                            continue;
                        }

                        const canvas = document.getElementById(`canvas-${asset.name}`);
                        const blob = await new Promise((resolve) => canvas.toBlob(resolve));
                        folder.file(asset.name, blob);
                    }

                    const readme = `Windows App Logo Generator\n\nAssets\\ 配下に生成物を配置してください。\n\n例:\nSquare150x150Logo=\"Assets\\\\Square150x150Logo.png\"\nSquare44x44Logo=\"Assets\\\\Square44x44Logo.png\"\n<uap:DefaultTile Wide310x150Logo=\"Assets\\\\Wide310x150Logo.png\" />\n<uap:SplashScreen Image=\"Assets\\\\SplashScreen.png\" />\n`;
                    zip.file("README.txt", readme);

                    const content = await zip.generateAsync({ type: "blob" });
                    const url = URL.createObjectURL(content);
                    const a = document.createElement("a");
                    a.href = url;
                    a.download = "windows-app-assets.zip";
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                } catch (err) {
                    console.error(err);
                    alert("ZIPの生成に失敗しました");
                }
            }

            function resetApp() {
                sourceImage = null;
                backgroundImage = null;
                fileInput.value = "";
                bgImageInput.value = "";
                bgImageThumb.src = "";
                bgImagePreview.style.display = "none";

                // reset settings
                bgType.value = "color";
                document.getElementById("colorBgSection").style.display = "block";
                document.getElementById("imageBgSection").style.display = "none";
                bgColor.value = "#2563eb";
                bgColorText.value = "#2563eb";
                wideScale.value = "70";
                splashScale.value = "50";
                wideScaleValue.textContent = "70%";
                splashScaleValue.textContent = "50%";

                setSettingsVisible(false);
                setPreviewVisible(false);
                assetsGrid.innerHTML = "";
                originalImage.src = "";
            }
        </script>
    </body>
</html>
